# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (used outside localhost)
# Example: https://your-api-domain.com
VITE_BACKEND_URL=https://phew.vibecode.run

# Local development backend override (used when app runs on localhost)
VITE_LOCAL_BACKEND_URL=http://localhost:3000

# Legacy/optional value (not required for Better Auth flows)
VITE_PRIVY_APP_ID=your-privy-app-id-here
