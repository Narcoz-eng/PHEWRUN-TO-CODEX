# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database URL (required)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=file:./dev.db

# Server Configuration
NODE_ENV=development
PORT=3000

# Backend URL used by API/OAuth callback generation
# Development: http://localhost:3000
# Production: https://your-backend-domain.com
BACKEND_URL=http://localhost:3000

# Optional explicit Better Auth URL override (defaults to BACKEND_URL)
# BETTER_AUTH_URL=http://localhost:3000

# Frontend URL for redirect allowlist / password reset flows
# Development: http://localhost:8000
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:8000

# Google OAuth (required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP configuration (required to send forgot-password emails)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# Optional: Debug mode
DEBUG=false

# Optional: Log level (all, errors, slow)
LOG_LEVEL=info
